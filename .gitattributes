* text=auto

# Windows 批处理必须 CRLF，否则双击可能出现 goto / pause 异常
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.md   text eol=lf
*.txt  text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.py   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.ass  text eol=lf

*.exe  binary
*.dll  binary
*.pyd  binary
*.zip  binary
*.ico  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.wav  binary
*.mp3  binary
*.m4a  binary
*.mp4  binary
